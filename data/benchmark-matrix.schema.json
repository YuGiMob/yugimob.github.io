{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "benchmark-matrix",
  "description": "Pass counts per scenario and contender behind the benchmark chart, derived from the same report as the benchmark block.",
  "type": "object",
  "required": ["generatedAt", "models", "scenarios", "contenders", "cells"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "focus"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "focus": { "type": "string", "enum": ["core", "staleness", "served-state"] }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contenders": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            { "type": "integer", "minimum": 0 }
          ]
        }
      }
    }
  }
}
