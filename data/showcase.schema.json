{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "showcase",
  "description": "The hand-curated half: the introduction, one rule and entry per tool, and the principles and colophon prose. Carries no numbers.",
  "type": "object",
  "required": ["intro", "problems", "principles", "colophon"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "intro": {
      "type": "object",
      "required": ["headline", "paragraphs"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kicker", "headline", "problem", "answer", "highlights", "size"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kicker": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "demo": { "type": "string", "minLength": 1 },
          "size": { "type": "string", "enum": ["hero", "default"] }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "colophon": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
