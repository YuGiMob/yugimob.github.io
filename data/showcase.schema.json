{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "showcase",
  "type": "object",
  "required": ["intro", "problems", "evidence", "principles", "colophon"],
  "additionalProperties": false,
  "properties": {
    "intro": {
      "type": "object",
      "required": ["headline", "paragraphs"],
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kicker", "headline", "problem", "answer", "highlights", "size"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kicker": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "demo": { "type": "string", "minLength": 1 },
          "size": { "type": "string", "enum": ["hero", "default"] }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["name", "kicker", "headline", "problem", "answer", "highlights", "benchmark"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kicker": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "demo": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 },
        "benchmark": {
          "type": "object",
          "required": ["source", "generatedAt", "models", "scenarios", "contenderCount", "runsPerContender", "contenders"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "format": "uri" },
            "generatedAt": { "type": "string", "minLength": 1 },
            "models": { "type": "integer", "minimum": 1 },
            "scenarios": { "type": "integer", "minimum": 1 },
            "contenderCount": { "type": "integer", "minimum": 1 },
            "runsPerContender": { "type": "integer", "minimum": 1 },
            "contenders": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "overall", "safety", "errors"],
                "additionalProperties": false,
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "overall": { "type": "number", "minimum": 0, "maximum": 100 },
                  "safety": { "type": "number", "minimum": 0, "maximum": 100 },
                  "errors": { "type": "integer", "minimum": 0 },
                  "highlight": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "colophon": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
