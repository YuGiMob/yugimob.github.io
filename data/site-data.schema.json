{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "site-data",
  "type": "object",
  "required": ["identity", "about", "projects", "stats", "activity", "sections"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["displayName", "classTitle", "tagline", "avatarUrl", "links"],
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "classTitle": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "avatarUrl": { "type": "string", "format": "uri" },
        "links": {
          "type": "object",
          "required": ["github", "email"],
          "additionalProperties": false,
          "properties": {
            "github": { "type": "string", "format": "uri" },
            "email": { "type": ["string", "null"], "format": "email" }
          }
        }
      }
    },
    "about": {
      "type": "object",
      "required": ["paragraphs"],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "language", "stars", "forks", "url", "npm", "license", "pushedAt"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "url": { "type": "string", "format": "uri" },
          "npm": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "npmWeeklyDownloads": { "type": "integer", "minimum": 0 },
          "pushedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["totalStars", "npmPackages", "publicRepos", "starsGiven", "forksReceived", "accountYears"],
      "additionalProperties": false,
      "properties": {
        "totalStars": { "type": "integer", "minimum": 0 },
        "npmPackages": { "type": "integer", "minimum": 0 },
        "publicRepos": { "type": "integer", "minimum": 0 },
        "starsGiven": { "type": "integer", "minimum": 0 },
        "forksReceived": { "type": "integer", "minimum": 0 },
        "accountYears": { "type": "integer", "minimum": 0 }
      }
    },
    "activity": {
      "type": "object",
      "required": ["window", "pushes", "highlights", "fetchedAt"],
      "additionalProperties": false,
      "properties": {
        "window": { "type": "string", "minLength": 1 },
        "pushes": { "type": "integer", "minimum": 0 },
        "highlights": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fetchedAt": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "object",
      "required": ["showBackground", "showArtifacts", "showQuestLog", "showAbilityScores", "showCampfire"],
      "additionalProperties": false,
      "properties": {
        "showBackground": { "type": "boolean" },
        "showArtifacts": { "type": "boolean" },
        "showQuestLog": { "type": "boolean" },
        "showAbilityScores": { "type": "boolean" },
        "showCampfire": { "type": "boolean" }
      }
    }
  }
}
