{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "showcase",
  "type": "object",
  "required": ["featured", "projects", "benchmark", "principles", "about", "lab"],
  "additionalProperties": false,
  "properties": {
    "featured": {
      "type": "object",
      "required": ["name", "kicker", "headline", "summary", "points", "demo"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kicker": { "type": "string", "minLength": 1 },
        "headline": { "type": "string", "minLength": 1 },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["title", "body"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 }
            }
          }
        },
        "demo": { "type": "string", "minLength": 1 }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kicker", "tagline", "highlights", "size"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kicker": { "type": "string", "minLength": 1 },
          "tagline": { "type": "string", "minLength": 1 },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "demo": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 },
          "size": { "type": "string", "enum": ["large", "small"] }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["source", "generatedAt", "models", "scenarios", "contenderCount", "runsPerContender"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "generatedAt": { "type": "string", "minLength": 1 },
        "models": { "type": "integer", "minimum": 1 },
        "scenarios": { "type": "integer", "minimum": 1 },
        "contenderCount": { "type": "integer", "minimum": 1 },
        "runsPerContender": { "type": "integer", "minimum": 1 },
        "contenders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "overall", "safety", "errors"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "overall": { "type": "number", "minimum": 0, "maximum": 100 },
              "safety": { "type": "number", "minimum": 0, "maximum": 100 },
              "errors": { "type": "integer", "minimum": 0 },
              "highlight": { "type": "boolean" }
            }
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "about": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "lab": {
      "type": "object",
      "required": ["title", "intro"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "minLength": 1 }
      }
    }
  }
}
