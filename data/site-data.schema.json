{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "site-data",
  "type": "object",
  "required": ["identity", "projects", "stats", "activity", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "identity": {
      "type": "object",
      "required": ["displayName", "classTitle", "tagline", "avatarUrl", "links"],
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "classTitle": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "avatarUrl": { "type": "string", "minLength": 1 },
        "links": {
          "type": "object",
          "required": ["github"],
          "additionalProperties": false,
          "properties": {
            "github": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "language", "stars", "forks", "url", "npm", "license", "pushedAt"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "url": { "type": "string", "format": "uri" },
          "npm": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "npmWeeklyDownloads": { "type": "integer", "minimum": 0 },
          "pushedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["totalStars", "npmPackages", "publicRepos", "forksReceived"],
      "additionalProperties": false,
      "properties": {
        "totalStars": { "type": "integer", "minimum": 0 },
        "npmPackages": { "type": "integer", "minimum": 0 },
        "publicRepos": { "type": "integer", "minimum": 0 },
        "forksReceived": { "type": "integer", "minimum": 0 }
      }
    },
    "activity": {
      "type": "object",
      "required": ["window", "pushes", "highlights", "fetchedAt"],
      "additionalProperties": false,
      "properties": {
        "window": { "type": "string", "minLength": 1 },
        "pushes": { "type": "integer", "minimum": 0 },
        "highlights": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "daily": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "events", "pushes"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "events": { "type": "integer", "minimum": 0 },
              "pushes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["source", "reportUrl", "tracesUrl", "generatedAt", "models", "scenarios", "focusCounts", "contenderCount", "runsPerContender", "totalRuns", "costUsd", "contenders"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "reportUrl": { "type": "string", "format": "uri" },
        "tracesUrl": { "type": "string", "format": "uri" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "models": { "type": "integer", "minimum": 1 },
        "scenarios": { "type": "integer", "minimum": 1 },
        "focusCounts": {
          "type": "object",
          "required": ["core", "staleness", "served-state"],
          "additionalProperties": false,
          "properties": {
            "core": { "type": "integer", "minimum": 0 },
            "staleness": { "type": "integer", "minimum": 0 },
            "served-state": { "type": "integer", "minimum": 0 }
          }
        },
        "contenderCount": { "type": "integer", "minimum": 1 },
        "runsPerContender": { "type": "integer", "minimum": 1 },
        "totalRuns": { "type": "integer", "minimum": 1 },
        "costUsd": { "type": "number", "minimum": 0 },
        "contenders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "version", "highlight", "overall", "safety", "served", "low", "high", "runs", "passed", "errors", "outcomes", "traceUrl"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] },
              "highlight": { "type": "boolean" },
              "overall": { "type": "number", "minimum": 0, "maximum": 100 },
              "safety": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "served": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "low": { "type": "number", "minimum": 0, "maximum": 100 },
              "high": { "type": "number", "minimum": 0, "maximum": 100 },
              "runs": { "type": "integer", "minimum": 1 },
              "passed": { "type": "integer", "minimum": 0 },
              "errors": { "type": "integer", "minimum": 0 },
              "outcomes": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 1 }
              },
              "traceUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "benchmarkHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "overall", "safety", "served"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "overall": { "type": "number", "minimum": 0, "maximum": 100 },
          "safety": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "served": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
        }
      }
    },
    "sections": {
      "type": "object",
      "required": ["showAbout", "showProblems", "showHeroStats", "showCampfire"],
      "additionalProperties": false,
      "properties": {
        "showAbout": { "type": "boolean" },
        "showProblems": { "type": "boolean" },
        "showHeroStats": { "type": "boolean" },
        "showCampfire": { "type": "boolean" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "totalStars", "totalDownloads"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "totalStars": { "type": "integer", "minimum": 0 },
          "totalDownloads": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
